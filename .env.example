# pixpick environment.
#
# Copy this file to `.env` and replace the secrets. Every variable below
# carries one mark: `Required` always needs a value, `Optional` may stay
# empty, and `Required when X=y` needs one only while X holds that value.

# Required. Selects runtime behavior, such as whether the frontend devtools
# mount and whether the backend accepts IDENTITY_PROVIDER=local.
# Values: development | production.
ENVIRONMENT=development

# Required. Prefixes the Docker Compose project, network and volume names.
# Changing it starts a second, empty set of containers and volumes.
COMPOSE_PROJECT_NAME=pixpick

# Required. Postgres credentials, for local development only.
POSTGRES_USER=pixpick
POSTGRES_PASSWORD=pixpick_dev_password

# Required. The database this project's data lives in. Changing it changes
# which albums, photos and ratings are visible; each name keeps its own
# data, so switching back finds the previous set as it was. Keep the
# database name in DATABASE_URL below equal to this one.
POSTGRES_DB=pixpick

# Required. How the backend reaches Postgres. The value below is the one it
# uses while running on the host, through POSTGRES_PORT. Running inside the
# environment, the services reach each other by service name, and whichever
# compose file you run composes that address itself. The database name here is a
# separate string, so changing POSTGRES_DB above means changing it here too.
DATABASE_URL=postgresql+psycopg://pixpick:pixpick_dev_password@localhost:5432/pixpick

# Required. Three ceilings every connection to Postgres carries into each
# session it opens (database-access spec): the longest a single statement
# may run, the longest an operation waits to acquire a lock, and the
# longest a transaction may sit open with nothing happening in it. All in
# milliseconds. Without them, one query with no cap of its own can hold its
# connection -- and the lock behind it -- forever.
STATEMENT_TIMEOUT_MS=30000
LOCK_TIMEOUT_MS=5000
IDLE_IN_TRANSACTION_TIMEOUT_MS=60000

# Required. Base URL the frontend uses for API calls. A relative value keeps
# every request on the origin the app was loaded from.
API_BASE_URL=/api

# Required. Host ports the environment publishes. Change them if they
# collide with another project. NGINX_PORT is the one the app opens on.
NGINX_PORT=8080
POSTGRES_PORT=5432

# Required. The site's own public address. Every absolute URL the backend
# builds starts from it: the redirect back into the app after signing in,
# and the address of each image variant. Matches NGINX_PORT above.
PUBLIC_URL=http://localhost:8080

# --- Identity -------------------------------------------------------------
# IDENTITY_PROVIDER decides which group applies. `local` has no credentials
# of its own, so it needs nothing from this section.

# Required. Selects how people sign in. Values: local | google. `local` is a
# form the backend serves itself, with no third party, and works only while
# ENVIRONMENT=development. `google` signs people in with the Google account
# they already have.
IDENTITY_PROVIDER=local

# Required when IDENTITY_PROVIDER=google. The application's credentials in
# Google's console, plus a redirect URI declared there. README.md has the
# steps that produce them.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Object storage -------------------------------------------------------
# STORAGE_PROVIDER decides which group applies. Only that group needs
# values; the other one can stay empty.

# Required. Selects where the photos are stored. Values: local | r2.
# `local` is MinIO, running in this environment as the `storage` service.
# `r2` is Cloudflare R2.
STORAGE_PROVIDER=local

# Required when STORAGE_PROVIDER=local. MinIO's own admin credentials, for
# local development only. The backend and the transformer both sign in with
# them.
MINIO_ACCESS_KEY_ID=pixpick
MINIO_SECRET_ACCESS_KEY=pixpick_dev_password

# Required when STORAGE_PROVIDER=local. The bucket every object of this
# project lives in. The backend creates it at startup when it is missing.
MINIO_BUCKET=pixpick

# Required when STORAGE_PROVIDER=local. Used only in native mode: the
# address MinIO is reached by when nothing sits in front of it, for both
# the browser and the backend. In containers mode the browser instead
# writes through STORAGE_PUBLIC_URL below, and MINIO_SERVER_ENDPOINT is
# composed by whichever compose file you run.
MINIO_BROWSER_ENDPOINT=http://localhost:9000
MINIO_SERVER_ENDPOINT=http://localhost:9000

# Required when STORAGE_PROVIDER=local. The address the browser writes to
# directly in containers mode, once MinIO is only reachable through the
# entry point (object-storage spec, local-environment spec, D1 in
# harden-local-profile's design) -- compose.yaml/compose.dev.yaml hand
# this to the backend as MINIO_BROWSER_ENDPOINT and to nginx as its own
# storage server block's hostname (nginx/entrypoint.sh derives it from
# this same value, so the two can never name different hostnames).
# `storage.localhost` resolves to this machine on its own in every major
# browser (no /etc/hosts entry needed). A real deployment behind a
# platform proxy (Dokploy or otherwise) names its own subdomain here
# instead, matching PUBLIC_URL's own domain. Reached by a bare private or
# VPN address with no domain of its own, an sslip.io/nip.io hostname
# works the same way with no DNS to run: e.g. for 192.168.1.50,
# `http://storage.192-168-1-50.sslip.io:8080` resolves to that address on
# its own, README.md has more on this.
STORAGE_PUBLIC_URL=http://storage.localhost:8080

# Required when STORAGE_PROVIDER=local. Host port the `storage` service
# publishes, so native mode and any S3 client can reach it directly.
# MINIO_BROWSER_ENDPOINT and MINIO_SERVER_ENDPOINT above use it. Left
# empty, Docker picks a port at random and those two addresses stop
# matching it.
MINIO_PORT=9000

# Required when STORAGE_PROVIDER=local. Comma-separated list of the
# origins allowed to upload directly to MinIO -- the application's own
# origin, never the storage's own (object-storage spec: this is a CORS
# check against the page that issued the request, and a page is never
# loaded from the storage's own hostname). Both ways of working are
# listed at once, so moving between them needs no change here.
MINIO_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000

# Required when STORAGE_PROVIDER=r2. An R2 API token's key pair, scoped to
# this project's bucket. README.md has the steps that produce them.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Required when STORAGE_PROVIDER=r2. The bucket every object of this project
# lives in, and the single address R2 is reached by
# (`https://<account_id>.r2.cloudflarestorage.com`). This bucket is created
# once in the Cloudflare dashboard; a missing one stops the backend at
# startup.
R2_BUCKET=
R2_ENDPOINT=

# --- Image variants -------------------------------------------------------
# IMAGE_PROVIDER decides which group applies. Only that group needs values;
# the other one can stay empty.

# Required. Selects what builds the address of each image variant.
# Values: local | imagekit. `local` is imgproxy, running in this environment
# as the `transformer` service. `imagekit` is ImageKit.
IMAGE_PROVIDER=local

# Required when IMAGE_PROVIDER=local. Hex-encoded key and salt the
# transformer checks every variant address against. Generate a real pair per
# environment with:
#   echo $(xxd -g 2 -l 64 -p /dev/random | tr -d '\n')
# The values below are for local development only.
IMAGE_SIGNING_KEY=6b6579666f726c6f63616c6465766f6e6c79646f6e6f747265757365
IMAGE_SIGNING_SALT=73616c74666f726c6f63616c6465766f6e6c79646f6e6f747265757365

# Required when IMAGE_PROVIDER=imagekit. ImageKit's own account address
# (`https://ik.imagekit.io/<your_id>`) and private key. README.md has the
# steps that produce them.
IMAGEKIT_URL_ENDPOINT=
IMAGEKIT_PRIVATE_KEY=

# Required when IMAGE_PROVIDER=local. What the transformer (`imgproxy`)
# is willing to process, declared explicitly instead of left at whatever
# the image ships with (image-delivery spec): the largest original it
# reads (megapixels), the largest original file it downloads (bytes,
# matching MAX_FILE_SIZE in backend/src/packages/photos/config.py), the
# largest result it ever produces (pixels, at least the catalog's own
# ceiling in backend/src/images/catalog.py), how many it processes at
# once, and how long it waits to download an original.
TRANSFORMER_MAX_SRC_RESOLUTION=40
TRANSFORMER_MAX_SRC_FILE_SIZE=20971520
TRANSFORMER_MAX_RESULT_DIMENSION=2048
TRANSFORMER_WORKERS=2
TRANSFORMER_DOWNLOAD_TIMEOUT_SECONDS=10

# Required. The most photos a single album admits. Lowering it never removes
# photos from an album that already holds more; it only blocks adding more.
ALBUM_MAX_PHOTOS=50

# Required. The most storage a single account can occupy, in bytes: the
# originals of the photos in its albums, and nothing derived from them.
# The default is 120 MiB. Lowering it never removes photos from an account
# that already occupies more; it only blocks adding more.
ACCOUNT_MAX_BYTES=125829120

# Required. The most storage the whole instance can occupy, in bytes: the
# same kind of total as ACCOUNT_MAX_BYTES above, summed over every account
# instead of one. The default is 6 GiB. Lowering it never removes photos
# from any account; it only blocks adding more, for everyone, until usage
# drops back under the new value.
INSTANCE_MAX_BYTES=6442450944

# Required. How many days an album lives without a new photo, counted from
# its last one, or from its creation until it has one. The default is 30.
# Unlike the two caps above, lowering it does not merely block new albums:
# it has an immediate effect on every album that already exists, expiring
# any of them older than the new value the instant the change takes effect.
# Accepts a fraction of a day (e.g. 0.0014, about two minutes), for testing
# a real expiry without waiting a whole day.
ALBUM_RETENTION_DAYS=30

# Required. How often, in seconds, the periodic cleanup discards expired
# uploads and expired albums together with their objects (photo-upload
# spec, album-retention spec). It stays invocable by hand too
# (`uv run python -m src.maintenance.reconcile`); this is what makes it
# also run on its own, since a local deployment shares its disk between
# the storage, the database and the cache -- what this discards is what
# keeps the instance's own quota describing what's actually on disk.
RECONCILE_INTERVAL_SECONDS=300

# Required. Longest a title or a description can be, in characters.
# Without a maximum the only ceiling is however much body the entry point
# accepts, a number nobody chose for this.
ALBUM_TITLE_MAX_LENGTH=200
ALBUM_DESCRIPTION_MAX_LENGTH=2000

# --- Rate limiting (request-throttling spec) -------------------------------
# Applied in nginx, by client address, before a request reaches the backend.

# Required. `false` raises every limit below to a ceiling nothing a real
# client reaches, for development and the test suite -- it does not remove
# the limits from nginx's own config, only makes them unreachable in practice.
RATE_LIMIT_ENABLED=true

# Required. The general ceiling over the whole API, in requests per
# minute per client address, and how many requests above that rate a
# short burst may still use before one gets rejected.
API_RATE_LIMIT_PER_MINUTE=600
API_RATE_LIMIT_BURST=50

# Required. The stricter ceiling over granting uploads specifically --
# the operation that reserves quota and mints a storage credential --
# counted separately from the general one above, so exhausting this one
# never blocks any other API call from the same client.
GRANTS_RATE_LIMIT_PER_MINUTE=30
GRANTS_RATE_LIMIT_BURST=5

# Required. How many requests from the same client address nginx keeps
# open to the API at once.
API_MAX_CONNECTIONS_PER_IP=20

# Required. How many seconds a rejection for lack of capacity -- by
# nginx's own rate limit, or by the backend's connection pool -- tells
# the client to wait before trying again.
RATE_LIMIT_RETRY_AFTER_SECONDS=5
