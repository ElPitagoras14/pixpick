# ---------------------------------------------------------------------------
# pixpick local environment configuration.
#
# Copy this file to `.env` and adjust secrets before starting the stack.
# Every variable here has a real consumer (compose.yaml, compose.dev.yaml,
# the frontend entrypoint, or backend/src/config.py) -- nothing orphaned.
#
# Two independent axes matter here (D4 in add-cloud-media-adapters). One is
# the EXECUTION MODE: "containers" (everything runs via `docker compose
# up`) or "native" (only third-party services run in containers; the
# backend runs with `uv` and the frontend with its dev server, both
# against those same containers) -- a few variables name a host that
# becomes a service name in containers mode and the local host in native
# mode (DATABASE_URL, MINIO_SERVER_ENDPOINT), each one's own comment says
# so, and compose.yaml is what overrides it for containers mode. The other
# is the PROVIDER SET: "local" (MinIO, imgproxy) or "cloud" (Cloudflare R2,
# ImageKit), selected by STORAGE_PROVIDER/IMAGE_PROVIDER -- each provider
# keeps its own group of settings (MINIO_*, R2_*, IMAGEKIT_*), so only the
# group the active value names needs real values, and it changes which
# database this project's data lives in (POSTGRES_DB), never which host
# reaches it. The two axes are independent: switching one never implies
# switching the other.
# ---------------------------------------------------------------------------

# Selects runtime behavior such as whether frontend devtools mount.
# Values: development | production.
ENVIRONMENT=development

# Prefixes the Docker Compose project/network/volume names.
COMPOSE_PROJECT_NAME=pixpick

# Activates the compose services the local provider set needs (`storage`,
# `storage-init`, `transformer`) -- Compose's own mechanism, read
# automatically from this file (D1 in add-cloud-media-adapters). Leave this
# set to switch STORAGE_PROVIDER/IMAGE_PROVIDER back to "local"; clear it
# (or remove the line) once every value below names the cloud provider set,
# so those three containers don't start for nothing.
COMPOSE_PROFILES=local

# Postgres credentials for local development only.
POSTGRES_USER=pixpick
POSTGRES_PASSWORD=pixpick_dev_password
# The database this project's data lives in -- one per provider set (D4 in
# add-cloud-media-adapters), never per execution mode: switching between
# containers and native mode reaches the very same database; switching
# this value is what actually changes which albums, photos and ratings are
# visible. Pick a different name for the cloud provider set (e.g.
# `pixpick_cloud`) so alternating between the two during development finds
# each one's own data intact, never the other's.
POSTGRES_DB=pixpick

# Single connection string the backend uses to reach Postgres (D7 in
# add-backend-data-layer's design). The value below is for native mode --
# the backend runs on the host, so it reaches Postgres via the port
# compose.dev.yaml publishes. In containers mode compose.yaml overrides this
# same variable for the backend service, composing it from the POSTGRES_*
# values above with the service name as host. Its own database name (the
# segment after the port) has to be kept equal to POSTGRES_DB by hand --
# it's a separate string, not derived from it, so changing POSTGRES_DB to
# switch provider set (D4 in add-cloud-media-adapters) means editing this
# value too. The backend's startup connectivity check catches a value
# that plainly can't connect, but not one that connects successfully to
# an existing database that's simply the wrong one -- exactly what a
# second, equally-real database (the cloud provider set's own) makes
# possible, so this one is on you to keep in sync.
DATABASE_URL=postgresql+psycopg://pixpick:pixpick_dev_password@localhost:5432/pixpick

# Base URL the frontend uses for API calls. Relative so the browser always
# requests the same origin it loaded the app from -- nginx in containers
# mode, the frontend dev server (which proxies it) in native mode.
API_BASE_URL=/api

# Host ports published by compose.dev.yaml. Change these instead of editing
# the compose files if they collide with another project.
NGINX_PORT=8080
POSTGRES_PORT=5432

# Selects the identity provider the backend authenticates people against.
# Values: local | google. "local" is a dev-only, credential-less provider (a
# form the backend itself serves, with no third party involved) and the
# backend refuses to start with it unless ENVIRONMENT=development. "google"
# needs the two credentials below and a redirect URI declared in Google's
# console (see README.md).
IDENTITY_PROVIDER=local

# The application's credentials in Google's console, required only when
# IDENTITY_PROVIDER=google -- left empty here since they're secrets, and
# because in development IDENTITY_PROVIDER=local doesn't need them at all.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The site's own public address. Used to build any absolute URL the
# backend generates -- such as the redirect back into the app once login
# completes -- from configuration instead of the incoming request's scheme
# or host, which nginx cannot report correctly once TLS is terminated in
# front of it (D9 in add-local-environment). Matches NGINX_PORT above. Also
# the base the local image adapter builds variant addresses from: nginx
# gains the images space in this change, so a variant's full address is
# this same value plus its signed path (D5 in add-media-ports-and-local-adapters).
PUBLIC_URL=http://localhost:8080

# Selects the object storage provider the backend and the transformer use.
# Values: local | r2. "local" is MinIO (D1 in
# add-media-ports-and-local-adapters), configured by the MINIO_* group
# below. "r2" is Cloudflare R2 (D9 in add-cloud-media-adapters), configured
# by the R2_* group further down. The two groups are entirely separate
# variables (D9 in add-cloud-media-adapters): only the group this value
# names needs real values, and only that group is what the backend
# actually reads -- the other can stay empty.
STORAGE_PROVIDER=local

# MinIO's own admin/root credentials, used for local development only --
# the same relationship POSTGRES_USER/PASSWORD have with Postgres, and the
# backend and the transformer both authenticate with these same
# credentials since there's no separate scoped user in local mode.
MINIO_ACCESS_KEY_ID=pixpick
MINIO_SECRET_ACCESS_KEY=pixpick_dev_password

# The bucket every object of this project lives in, in MinIO.
MINIO_BUCKET=pixpick

# MinIO is reached by two different addresses (D4 in
# add-media-ports-and-local-adapters): the browser writes directly to it,
# so it needs the address reachable from the host; the backend queries and
# deletes objects by the address reachable from where it runs. The values
# below are for native execution -- the backend runs on the host, so it
# reaches MinIO via the port compose.dev.yaml publishes; in containers mode
# compose.yaml overrides MINIO_SERVER_ENDPOINT to the service name
# (`storage:9000`), the same relationship DATABASE_URL has with Postgres.
MINIO_BROWSER_ENDPOINT=http://localhost:9000
MINIO_SERVER_ENDPOINT=http://localhost:9000

# Host port MinIO publishes, so the browser (and the MINIO_*_ENDPOINT
# values above) can reach it, and so it can be inspected with an S3 client.
MINIO_PORT=9000

# Origins allowed to upload directly to MinIO (D3, D9 in
# add-media-ports-and-local-adapters): a comma-separated list, applied by
# the storage service itself at startup (MinIO has no per-bucket CORS API;
# this is a server-wide setting, precise enough with the single bucket
# this project has). Both working-mode origins are listed at once, so
# switching between them needs no reconfiguration of the running storage:
# nginx in containers mode, and the frontend's own dev server in
# native mode.
MINIO_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000

# An R2 API token's key pair, scoped to this project's bucket alone
# (README.md has the exact steps) -- empty here since STORAGE_PROVIDER
# above doesn't need it while it's "local".
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# The bucket every object of this project lives in, in R2.
R2_BUCKET=

# A single address, not two (D7 in add-cloud-media-adapters): R2 is public
# from every side, so the browser and the server reach it the same way --
# `https://<account_id>.r2.cloudflarestorage.com`.
R2_ENDPOINT=

# Selects the image transformation provider the backend builds variant
# addresses with. Values: local | imagekit. "local" is imgproxy, running in
# this compose, reading originals from the storage above by itself (D1, D2
# in add-media-ports-and-local-adapters). "imagekit" is ImageKit (D9 in
# add-cloud-media-adapters), pointed at the R2 bucket above as its origin
# (see README.md for setup).
IMAGE_PROVIDER=local

# Hex-encoded key/salt pair the transformer verifies every variant address
# against (image-delivery spec: "las direcciones de variante van
# firmadas"), required only when IMAGE_PROVIDER=local. Generate a real pair
# per environment with:
#   echo $(xxd -g 2 -l 64 -p /dev/random | tr -d '\n')
# The values below are for local development only -- never reuse them
# anywhere a stranger could request transformations for free.
IMAGE_SIGNING_KEY=6b6579666f726c6f63616c6465766f6e6c79646f6e6f747265757365
IMAGE_SIGNING_SALT=73616c74666f726c6f63616c6465766f6e6c79646f6e6f747265757365

# ImageKit's own account address and private key, required only when
# IMAGE_PROVIDER=imagekit -- left empty here since IMAGE_PROVIDER=local
# doesn't need them at all (README.md has the exact steps).
IMAGEKIT_URL_ENDPOINT=
IMAGEKIT_PRIVATE_KEY=

# The most photos a single album admits (D14 in add-albums-and-upload). A
# product constraint -- rating an album photo by photo stops being
# viable long before storage cost would -- not a resource quota, which is
# why it lives here as the one setting of its kind rather than as a
# constant: it varies by product decision, unlike the batch ceiling, the
# file size limit, and the allowed file types, which stay fixed in code.
# Lowering it never removes photos from an album that already exceeds it;
# it only blocks adding more.
ALBUM_MAX_PHOTOS=50
