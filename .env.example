# pixpick environment. Copy this file to `.env`.
#
# Grouped by area, so what you touch at once stays together. A variable
# tagged `optional` already works as it is; `when X=y` needs a value only
# while X holds that value. Everything else needs one from you.


# =============================================================================
# CONFIGURE
# =============================================================================

# --- Instance ---

# development | production. `production` drops the frontend devtools and
# makes the backend refuse IDENTITY_PROVIDER=local.
ENVIRONMENT=development

# optional. Prefixes the Compose project, network and volume names, so
# changing it starts a second, empty set of containers and volumes.
COMPOSE_PROJECT_NAME=pixpick

# --- Network ---

# The site's own public address. Every absolute URL the backend builds
# starts from it, so it has to name NGINX_PORT below.
PUBLIC_URL=http://localhost:8080

# optional. Host ports; change one on a collision. PUBLIC_URL and
# STORAGE_PUBLIC_URL follow NGINX_PORT, and the two MinIO endpoints
# follow MINIO_PORT. Left empty, Docker picks one at random.
NGINX_PORT=8080
POSTGRES_PORT=5432
MINIO_PORT=9000

# optional. Where the frontend sends its API calls. Relative keeps every
# request on the origin the app was loaded from.
API_BASE_URL=/api

# --- Database ---

# Replace before this reaches anything but a development machine.
POSTGRES_PASSWORD=pixpick_dev_password

# Host value, through POSTGRES_PORT; in containers each compose file
# composes its own. Its database name has to match POSTGRES_DB.
DATABASE_URL=postgresql+psycopg://pixpick:pixpick_dev_password@localhost:5432/pixpick

# optional. Each database name keeps its own albums, photos and ratings,
# so switching back finds the previous set as it was.
POSTGRES_USER=pixpick
POSTGRES_DB=pixpick

# --- Identity ---

# local | google. `local` is a form the backend serves itself: type any
# email and you are that person. Only while ENVIRONMENT=development.
IDENTITY_PROVIDER=local

# when IDENTITY_PROVIDER=google. An OAuth client ID of type "Web
# application". README.md has the steps, including the redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Object storage ---

# local | r2. `local` is the MinIO running as the `storage` service. An r2
# bucket has to exist first; the backend stops at startup if it does not.
STORAGE_PROVIDER=local

# when STORAGE_PROVIDER=local. MinIO's own admin credentials. Replace the
# second before this reaches anything but a development machine.
MINIO_ACCESS_KEY_ID=pixpick
MINIO_SECRET_ACCESS_KEY=pixpick_dev_password

# when STORAGE_PROVIDER=local, native mode only: MinIO with nothing in
# front of it. In containers each compose file composes its own.
MINIO_BROWSER_ENDPOINT=http://localhost:9000
MINIO_SERVER_ENDPOINT=http://localhost:9000

# when STORAGE_PROVIDER=local. Where the browser uploads to. A hostname,
# never a bare IP with a port: nginx routes uploads by the `Host` header.
# Anything under `.localhost` resolves here on its own. Reaching this by a
# private or VPN address means an sslip.io or nip.io hostname instead of
# the address itself -- README.md has that one and the real-domain case.
STORAGE_PUBLIC_URL=http://storage.localhost:8080

# optional, when STORAGE_PROVIDER=local. The bucket, created at startup if
# missing, and the origins allowed to upload straight to it -- the app's
# own, never the storage's. Both ways of working are listed at once.
MINIO_BUCKET=pixpick
MINIO_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000

# when STORAGE_PROVIDER=r2. A token's key pair scoped to the bucket, the
# bucket, and `https://<account_id>.r2.cloudflarestorage.com`. README.md
# has the steps.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=

# --- Image variants ---

# local | imagekit. `local` is the imgproxy running as the `transformer`
# service, and it only works alongside STORAGE_PROVIDER=local.
IMAGE_PROVIDER=local

# when IMAGE_PROVIDER=local. Hex-encoded, and the same pair the
# transformer verifies every variant address against. Generate your own:
#   echo $(xxd -g 2 -l 64 -p /dev/random | tr -d '\n')
IMAGE_SIGNING_KEY=6b6579666f726c6f63616c6465766f6e6c79646f6e6f747265757365
IMAGE_SIGNING_SALT=73616c74666f726c6f63616c6465766f6e6c79646f6e6f747265757365

# when IMAGE_PROVIDER=imagekit. The account's URL endpoint
# (`https://ik.imagekit.io/<your_id>`) and private key. README.md has the
# steps.
IMAGEKIT_URL_ENDPOINT=
IMAGEKIT_PRIVATE_KEY=


# =============================================================================
# TUNE
# =============================================================================
#
# Nothing below needs a value to get started.

# --- Limits ---

# Photos one album takes.
ALBUM_MAX_PHOTOS=50

# Bytes one account takes, and bytes the whole instance takes: originals
# only, nothing derived. 120 MiB and 6 GiB.
ACCOUNT_MAX_BYTES=125829120
INSTANCE_MAX_BYTES=6442450944

# Days an album lives without a new photo. Unlike the two caps above,
# lowering this expires albums that already exist, with their photos.
# Takes a fraction of a day (0.0014 is about two minutes) for testing.
ALBUM_RETENTION_DAYS=30
