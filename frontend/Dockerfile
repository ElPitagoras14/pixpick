# --- build ---
FROM node:22-slim AS build

WORKDIR /app

RUN corepack enable && corepack prepare pnpm@10.33.0 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

COPY . .
RUN pnpm generate-routes && pnpm build

# --- serve ---
FROM nginx:1.30.4

COPY nginx.conf /etc/nginx/conf.d/default.conf

# The template stays outside the served html root; only its substituted
# output (config.js, generated by the entrypoint) belongs there.
COPY config.template.js /etc/pixpick/config.template.js
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80

ENTRYPOINT ["/entrypoint.sh"]
