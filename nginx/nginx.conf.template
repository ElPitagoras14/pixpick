# Upstreams go through a variable so nginx resolves them per request. With a
# bare hostname it refuses to start when the container is down, and never
# re-resolves after a restart.
resolver 127.0.0.11 valid=30s;

# use_temp_path=off writes into the cache tree itself, not a staging path.
proxy_cache_path /var/cache/nginx/images levels=1:2 keys_zone=images_cache:10m
	max_size=2g inactive=30d use_temp_path=off;

# compose.yaml/compose.dev.yaml's own ip_range, which the two have to keep
# equal. It leaves out the gateway, the address a connection from outside
# arrives as, so a forged X-Forwarded-For from there is not trusted.
set_real_ip_from 172.30.238.128/25;
real_ip_header X-Forwarded-For;

limit_req_zone $binary_remote_addr zone=api_rate:10m rate=600r/m;
limit_req_zone $binary_remote_addr zone=grants_rate:10m rate=30r/m;
limit_conn_zone $binary_remote_addr zone=api_conn:10m;

# 429, distinct from the 503 the backend answers with for its own capacity.
limit_req_status 429;
limit_conn_status 429;

server {
	listen 80;
	server_name _;

	location /api/ {
		limit_req zone=api_rate burst=50 nodelay;
		limit_conn api_conn 20;
		error_page 429 = @rate_limited;

		set $backend_upstream pixpick-backend:8000;
		proxy_pass http://$backend_upstream;
		proxy_set_header Host $host;
		proxy_set_header X-Real-IP $remote_addr;
		proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
		proxy_set_header X-Forwarded-Proto $scheme;

		# No fallback to the SPA on purpose: an unresponsive backend has to
		# surface as a gateway error, never as the app's HTML with a 200.
	}

	# A regex location wins over the plain-prefix /api/ above, so these
	# directives replace that location's rather than adding to them.
	location ~ ^/api/albums/[^/]+/photos/grants$ {
		limit_req zone=api_rate burst=50 nodelay;
		limit_req zone=grants_rate burst=5 nodelay;
		limit_conn api_conn 20;
		error_page 429 = @rate_limited;

		set $backend_upstream pixpick-backend:8000;
		proxy_pass http://$backend_upstream;
		proxy_set_header Host $host;
		proxy_set_header X-Real-IP $remote_addr;
		proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
		proxy_set_header X-Forwarded-Proto $scheme;
	}

	# The backend's own error_envelope() written out by hand, and it has to
	# keep matching it.
	location @rate_limited {
		default_type application/json;
		add_header Retry-After 5 always;
		return 429 '{"data":null,"error":{"code":"rate_limited","message":"too many requests; please retry shortly","field":null,"requestId":null,"details":null,"retryAfterSeconds":5}}';
	}

	location /images/ {
		# imgproxy owns a vocabulary rooted at "/", so the prefix is stripped.
		# By rewrite, not by a URI on proxy_pass, which a variable target
		# ignores. And `set` before `rewrite`, because `break` stops the
		# rewrite module's directives for the rest of the location.
		set $transformer_upstream transformer:8080;
		rewrite ^/images/(.*)$ /$1 break;
		proxy_pass http://$transformer_upstream;
		proxy_set_header Host $host;
		proxy_set_header X-Real-IP $remote_addr;
		proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
		proxy_set_header X-Forwarded-Proto $scheme;

		proxy_cache images_cache;
		proxy_cache_key $uri;
		# A variant address is immutable, so a long window costs nothing.
		proxy_cache_valid 200 30d;
		proxy_cache_lock on;
		proxy_cache_lock_timeout 30s;
		proxy_cache_use_stale error timeout http_500 http_502 http_503 http_504;
		add_header X-Cache-Status $upstream_cache_status always;
	}

	location / {
		set $frontend_upstream pixpick-frontend:80;
		proxy_pass http://$frontend_upstream;
		proxy_set_header Host $host;
		proxy_set_header X-Real-IP $remote_addr;
		proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
		proxy_set_header X-Forwarded-Proto $scheme;
	}
}

# Matched by hostname rather than by path: a grant's signature covers the Host
# and the path, and rewriting either would invalidate it. entrypoint.sh
# substitutes server_name from STORAGE_PUBLIC_URL.
server {
	listen 80;
	server_name ${STORAGE_PUBLIC_HOSTNAME};

	location / {
		set $storage_upstream storage:9000;
		proxy_pass http://$storage_upstream;
		# $http_host, not $host: the signature covers the port too, and $host
		# strips it.
		proxy_set_header Host $http_host;
		proxy_set_header X-Real-IP $remote_addr;
		proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
		proxy_set_header X-Forwarded-Proto $scheme;

		# photos/config.py's MAX_FILE_SIZE of 20 MiB plus a margin for the
		# upload protocol. The two change together.
		client_max_body_size 21m;

		# Off, the body streams through instead of being written to disk first.
		proxy_request_buffering off;
	}
}
